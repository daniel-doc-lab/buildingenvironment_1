# ---------------------------------------------------------------
# Fluks – miljøvariabler. Kopiér til .env.local og udfyld.
# Alt er valgfrit i demo: uden variabler kører appen med indlejret
# database (PGlite), sandbox-bank, sandbox-regnskab og demo-AI.
# ---------------------------------------------------------------

# Påkrævet i produktion: hemmelighed til sessioner og kryptering (mindst 32 tegn)
AUTH_SECRET=
# Valgfri separat krypteringsnøgle til API-nøgler/tokens i databasen (standard: AUTH_SECRET)
ENCRYPTION_KEY=
# Offentlig URL, bruges i e-mails og bank-redirects
APP_URL=http://localhost:3000

# Database: Postgres (fx Supabase/Neon). Tom = indlejret PGlite i ./.data
DATABASE_URL=
# Direkte (ikke-poolet) forbindelse til advisory lock ved migrering – sættes automatisk af Vercel/Neon
DATABASE_URL_UNPOOLED=
# Sæt "false" for ikke at oprette demovirksomheden
SEED_DEMO=true

# AI – Claude fra Anthropic (https://console.anthropic.com). Tom = demo-AI.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Bank connect (PSD2) via Enable Banking. Tom = sandbox-bank.
ENABLEBANKING_APP_ID=
ENABLEBANKING_PRIVATE_KEY=

# e-conomic app (https://www.e-conomic.dk/udvikler)
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_APP_PUBLIC_TOKEN=

# Boligflow API (alternativt indtastes nøglen pr. virksomhed i appen)
BOLIGFLOW_API_URL=

# Udgående e-mail via Resend. Tom = e-mails logges i appen.
RESEND_API_KEY=
EMAIL_FROM=Fluks <noreply@dit-domæne.dk>

# Beskyttelse af webhooks og cron
INBOUND_EMAIL_SECRET=
CRON_SECRET=
